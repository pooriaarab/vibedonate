{
  "name": "vibedonate",
  "version": "0.4.4",
  "description": "Experimental local compute-sharing CLI with Hyperswarm transport, Ollama availability checks, MCP capacity tools, and metering.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "bin": {
    "vibedonate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/mcp.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pooriaarab/vibe-core": "^0.6.0",
    "hyperswarm": "^4.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "hyperdht": "^6.33.0",
    "tsup": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.0"
  },
  "homepage": "https://github.com/pooriaarab/vibedonate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/vibedonate.git"
  },
  "bugs": {
    "url": "https://github.com/pooriaarab/vibedonate/issues"
  },
  "keywords": [
    "vibedonate",
    "vibe-suite",
    "local-compute",
    "inference",
    "ollama",
    "hyperswarm",
    "mcp",
    "peer-to-peer",
    "consent",
    "metering",
    "nodejs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.pooriaarab/vibedonate"
}
